# 复制本文件为 secrets.local.properties 并填入真实值。
# secrets.local.properties 已被 .gitignore 忽略，绝不入库。
# 仅 beta flavor 的默认值从这里注入；open（发布）flavor 一律注入空串。

# GLM / OpenAI 兼容分析接口
GLM_BASE_URL=https://api.example.com/v1
GLM_API_KEY=your-api-key-here
GLM_MODEL=your-model-name

# System One / JEV 评分接口（可选）
JEV_URL=http://127.0.0.1:8124
JEV_API_KEY=your-key-here

# 配套消息服务器（Flask 服务端）
MONITOR_URL=http://192.168.1.100:8000/weixin
MONITOR_TOKEN=your-long-random-token
