subgraph STORE["server/data/ · 落地存储（备份=拷贝这些文件）"]
    direction TB
    JSONL[("messages.jsonl<br/>原始归档 · 含重复上报<br/>字段与 Android 上报格式一致")]
    DB[("messages.db · SQLite<br/>表 messages：sender/text/timestamp/<br/>conversation/is_group/received_at/source<br/>UNIQUE idx_messages_dedup<br/>(conversation,sender,timestamp,text)<br/>表 analyses：case_id UNIQUE +<br/>importance/escalated/s1/s2/forks/filtered")]
    ADV[("advisor_reports.json<br/>ADVISOR_PATH @55")]
    ADB[("android_db/EnMicroMsg.db<br/>模拟器拉回的加密原件 · gitignored")]
    AST[("android_db/state.json<br/>增量游标 = 上次 max msgId")]
    PST[("pc_db/state.json")]
end

subgraph LEGS["提取腿 · 两条独立实现"]
    direction TB
    subgraph ALEG["android_db_extract.py · 20979 B"]
        direction TB
        A1["MuMuManager.exe sh -v 0 -c<br/>root shell（adb shell 无 su）"]
        A2["定位 MicroMsg/ 下 32位hex 账户目录<br/>= md5('mm'+uin)，内含 EnMicroMsg.db"]
        A3["解析 default_uin ← MMKV<br/>files/mmkv/system_config_prefs<br/>（protobuf varint）"]
        A4["IMEI 候选链：service call iphonesubinfo<br/>→ WLOGIN_DEVICE_INFO.xml<br/>→ 兜底 1234567890ABCDEF"]
        A5["密钥 = MD5(IMEI + str(uin))[:7].lower()<br/>WCDB2/SQLCipher 页加密<br/>pageSize=1024 · PBKDF2-HMAC-SHA1<br/>4000 轮 · HMAC off · reserve=16(仅IV)"]
        A6["root cp → /data/local/tmp && chmod 644<br/>adb pull → data/android_db/"]
        A7["纯 Python pycryptodome 逐页 AES-CBC<br/>用第1页 page-size 字段验证密钥命中"]
        A8["读 message / rcontact / chatroom<br/>私聊 talker=wxid → rcontact 备注/昵称<br/>群聊 talker=群id@chatroom<br/>群内容 = 发送者wxid + 换行 + 正文<br/>isSend=1 → sender 记为「我」<br/>type=1 原文，其余类型占位符"]
        A9["写 messages.db source='android-db'<br/>跨源去重键 (conversation,sender,秒级ts,text)<br/>清理设备临时文件"]
        A1 --> A2 --> A3 --> A4 --> A5 --> A6 --> A7 --> A8 --> A9
    end
    subgraph PLEG["pc_db_extract.py · 17082 B"]
        direction TB
        P1["PC 微信 4.x Msg*.db<br/>SQLCipher 4 · pageSize=4096<br/>HMAC-SHA512 · 256000 轮"]
        P2["密钥来自内存搜索/进程注入<br/>WX_TOOLCHAIN 环境变量<br/>参考 reverse/case-wechat4/wx_read_test.py"]
        P3["MSG_DB_REL=message/message_0.db<br/>CONTACT_DB_REL=contact/contact.db<br/>SKIP_USERS={qqmail,fmessage,medianote,...}<br/>SOURCE_TAG='pc-db'"]
        P4["snapshot_and_decrypt → 临时目录<br/>_contact_name_map / _resolve_self_username<br/>_parse_row → run_extract(full, account)"]
        P1 --> P2 --> P3 --> P4
    end
end

