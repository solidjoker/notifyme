    subgraph READ["查询 API · PWA / App 回读（routes.py）"]
        direction LR
        QM["GET /messages  @routes.py:169<br/>conversation 模糊 · date · limit≤1000<br/>timestamp DESC + source 徽标 + 翻页游标<br/>typeof 守卫挡掉非数值脏行（防游标毒化）<br/>返回 skipped = 该过滤范围内被挡掉的行数"]:::srv
        QA["GET /analysis  @routes.py:568<br/>todo_only=1 只看待办<br/>s1/s2 反解析为对象<br/>typeof(received_at) 常驻守卫<br/>skipped = 守卫挡掉 + 映射失败（修前恒 0）"]:::srv
        QAD["GET /advisor  @routes.py:845<br/>query_advisor()<br/>limit 默认 20 / 上限 100<br/>{ok, count, total, has_more, reports}<br/>total = 存档总数（ADVISOR_MAX_REPORTS=1000）<br/>has_more = 本次被截断"]:::srv
        QQ["GET /queue  @routes.py:1029<br/>query_queue()<br/>{ok, tasks[], summary{queued,running,failed,done,stale,total,devices,devices_active}}<br/>summary = 全库口径（不受 limit 截断），tasks = 当前页<br/>devices[] 设备聚合（total / active 过 TTL / stale）<br/>devices_active = 其中 active > 0 的台数（概览条只读它）<br/>stale = 30 分钟未更新<br/>控制台状态 chip 计数与汇总同源（全库），空态区分当前页/全库"]:::srv
    end

    subgraph PARTIAL["部分接受 207 · 路由层语义"]
