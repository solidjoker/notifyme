        QM["GET /messages  @276<br/>conversation 模糊 · date · limit≤1000<br/>timestamp DESC + source 徽标"]
        QA["GET /analysis  @438<br/>todo_only=1 只看待办<br/>s1/s2 反解析为对象"]
        QAD["GET /advisor  @584"]
    end

    subgraph EXTRACT["提取编排 · 服务端触发 DB 直读"]
        direction TB
        AE["POST /admin/extract  @648<br/>full=1 全量 · source ∈ android|pc|all<br/>409 = 已在跑"]
        ST["_extract_status 内存态 @609<br/>{running, last} + _extract_lock"]
        BG["_run_extract_bg(full, source)  @622<br/>daemon Thread<br/>mod = __import__(leg + '_db_extract')<br/>result[leg] = mod.run_extract(full=full)<br/>单腿失败不拖垮另一腿"]
        AS["GET /admin/extract/status  @679<br/>{ok, running, last}<br/>scanned/inserted/duplicated/skipped/elapsed_sec"]
        AE --> BG
        BG --> ST
        ST --> AS
    end

