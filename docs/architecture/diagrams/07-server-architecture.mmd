    subgraph AUTH["鉴权层"]
        CK["check_token()  @152<br/>接受 Header X-Token 或 Query ?token=<br/>WEIXIN_TOKEN 未设置时全部放行<br/>例外：/console/manifest.json 与 /sw.js 免鉴权"]
