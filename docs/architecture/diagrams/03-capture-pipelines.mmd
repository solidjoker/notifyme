%%{init: {'theme':'base','themeVariables':{'fontSize':'14px','fontFamily':'Microsoft YaHei, PingFang SC, sans-serif'},'flowchart':{'htmlLabels':true}}}%%
flowchart LR
    classDef src  fill:#fff3e0,stroke:#e65100,stroke-width:1.5px,color:#4e342e
    classDef cap  fill:#e8f5e9,stroke:#2e7d32,stroke-width:1.5px,color:#1b5e20
    classDef proc fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px,color:#0d47a1
    classDef st   fill:#eceff1,stroke:#455a64,stroke-width:1.5px,color:#263238
    classDef srv  fill:#f3e5f5,stroke:#6a1b9a,stroke-width:1.5px,color:#4a148c

    WX["微信 com.tencent.mm"]:::src
    FS["飞书 com.ss.android.lark"]:::src
    DT["钉钉 com.alibaba.android.rimet"]:::src

    subgraph CH1["通道 ① 通知监听 · 实时增量多应用（主链路）"]
        direction TB
        NL["NotifyMeListener"]:::cap
        NLF["AppSourceStore 启用集合过滤<br/>黑名单/被停用包跳过<br/>丢弃 ongoing / 状态类 / 聚合摘要"]:::proc
        NLP["AppSourceRegistry 路由 parser<br/>微信 MessagingStyle / 飞书钉钉 PrefixIm<br/>未收录 App 走 Generic 兜底"]:::proc
        NLD["LRU 去重<br/>同 key 同内容只入库一次"]:::proc
        NL --> NLF --> NLP --> NLD
    end

    subgraph CH2["通道 ② 无障碍直读 · 本机会话历史（免 root）"]
        direction TB
        A1["A11yExtractService（仅微信启用）<br/>控制台「开始提取」置位 startRequested"]:::cap
        A2["识别会话标题<br/>资源 id 候选表 → 标题栏文本启发式"]:::proc
        A3["循环：解析当前屏 → 向上翻页 → 去重合并<br/>气泡正文取行内面积最大文本节点"]:::proc
        A4["连续 NO_NEW_LIMIT 屏无新增判定到顶<br/>时间戳按采集顺序每秒递减估算<br/>source = a11y-extract"]:::proc
        A1 --> A2 --> A3 --> A4
    end

    subgraph CH3["通道 ③ 服务端数据库直读 · 完整历史（需 PC + root 通道）"]
        direction TB
        H["HistorySync.maybeRunOnStartup<br/>启动自动触发 · 6 小时冷却"]:::cap
        HG["隐私门控 HistorySyncCore<br/>LOCAL_ONLY → 整个云端回填停用<br/>CLOUD_REDACT → 不触发直读（原文无法端上脱敏）<br/>OFF → 全放行"]:::proc
        S1["POST /admin/extract?source=android|pc|all<br/>routes.py:844 · 后台线程异步执行"]:::srv
        S2["android_db_extract.py · 1260 行<br/>MD5(IMEI+uin)[:7] 推导密钥<br/>AES-CBC 逐页解密 · pageSize=1024<br/>PBKDF2-HMAC-SHA1 · 4000 迭代"]:::srv
        S3["pc_db_extract.py · 1122 行<br/>PC 微信 4.x message_0.db + contact.db"]:::srv
        S4["轮询 GET /admin/extract/status<br/>routes.py:889<br/>→ GET /messages?limit=1000"]:::srv
        S5["翻页回填 next_before 复合游标 毫秒_rowid<br/>HistorySyncCore.shouldFetchNext<br/>MAX_PAGES=20 · 游标不变即停"]:::proc
        H --> HG
        HG --> S1
        S1 --> S2
        S1 --> S3
        S1 --> S4
        S4 --> S5
    end

    MSG[("MessageStore<br/>files/messages.jsonl · MessageStore.kt:93<br/>ChatMessage: sender/text/timestamp<br/>/conversation/isGroup/source/pkg")]:::st
    PEND[("PendingQueue<br/>files/pending.jsonl · PendingQueue.kt:66<br/>自增 id 便于精确剔除")]:::st
    SRVDB[("服务端 messages.db<br/>init_db @storage.py:57<br/>UNIQUE(pkg,conversation,sender,timestamp,text)<br/>跨来源按秒级归一键去重")]:::st

    WX -->|"系统通知"| NL
    FS -->|"系统通知"| NL
    DT -->|"系统通知"| NL
    WX -->|"AccessibilityEvent"| A1
    WX -.->|"MuMuManager root shell<br/>cp + adb pull"| S2

    NLD -->|"ChatMessage"| MSG
    A4 -->|"mergeAndCollect"| MSG
    S5 -->|"MessageStore.merge 秒级去重回填"| MSG

    MSG -->|"新增条目挂载"| PEND
    PEND -->|"SyncWorker 通道 1<br/>POST /weixin"| SRVDB
    MSG -->|"AnalysisWorker 取最近 ≤10 条组 case"| ANA["会话窗口 case<br/>caseId = sha1(pkg|conversation|windowEnd)[:16]"]:::proc
