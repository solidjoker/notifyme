        O1["全部 DEFAULT_* buildConfigField = 空串<br/>APK 内不含任何密钥字符串"]
        O2["DEFAULT_ANALYSIS_PROTOCOL / URL / KEY / MODEL<br/>DEFAULT_LAYA_URL / KEY<br/>DEFAULT_SERVER_URL / MONITOR_TOKEN<br/>全部为空 → 用户自行填写"]
