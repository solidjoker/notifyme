subgraph DEVICE["设备安装与授权（adb install 之后）"]
    direction TB
    D0["adb install app/build/outputs/apk/open/debug/notifyme-open.apk"]
    D1["通知监听 = 特殊权限<br/>BIND_NOTIFICATION_LISTENER_SERVICE<br/>不能运行时申请<br/>必须去 Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS 手动开"]
    D2["验证：adb shell settings get secure<br/>enabled_notification_listeners"]
    D3["无障碍服务<br/>BIND_ACCESSIBILITY_SERVICE<br/>系统设置 → 无障碍 手动开启"]
    D4["电池白名单<br/>REQUEST_IGNORE_BATTERY_OPTIMIZATIONS<br/>主页 btnBatteryWhitelist"]
    D5["开机自启 BootReceiver<br/>BOOT_COMPLETED → KeepAliveService<br/>Android 12+ 后台起 FGS 会被拒<br/>ForegroundServiceStartNotAllowedException<br/>兜底：来通知时系统自动 bind 监听器<br/>+ 60s 看门狗 requestRebind"]
    D6["日志：adb logcat -s WeChatListener:I"]
    D0 --> D1 --> D2
    D0 --> D3
    D0 --> D4
    D0 --> D5
end

subgraph SVRSTART["服务端启动 · PC 宿主机"]
    direction TB
    S0["依赖：requirements.txt 仅 flask==3.1.3<br/>在 server/ 目录用本机 .venv<br/>.venv\Scripts\python.exe app.py<br/>默认 0.0.0.0:8000 · set PORT=9000 可改"]
    BAT["server\启动服务.bat 三件事"]
    S1["① set WEIXIN_TOKEN<br/>真值在 gitignored server\secrets.local.bat<br/>改令牌必须同步改 App 的「访问令牌」<br/>并重按「保存并启用定时上报」，否则 401"]
    S2["② adb connect 127.0.0.1:16384（MuMu）<br/>adb reverse tcp:8000 tcp:8000<br/>模拟器内 http://127.0.0.1:8000 直达宿主<br/>免局域网 IP / 防火墙问题"]
    S3["③ 前台运行 Flask，Ctrl+C 停止"]
    S4["注意：adb reverse 存活于 adbd<br/>模拟器重启即失效 → 每次重跑 bat"]
    S5["Windows 防火墙：放行入站 TCP 8000 Private<br/>New-NetFirewallRule -DisplayName WeixinServer 8000<br/>-Direction Inbound -Protocol TCP -LocalPort 8000<br/>-Action Allow -Profile Private"]
    S6["可选计划任务（每小时增量提取）<br/>schtasks /create /tn NotifymeAndroidExtract<br/>/tr .venv\Scripts\python.exe ...\android_db_extract.py<br/>/sc hourly"]
    BAT --> S1
    BAT --> S2
    BAT --> S3
    S3 --> S4
    S0 --> S5
end

subgraph DEPLOY["两条访问链路"]
    direction TB
    subgraph LAN["链路 A · 局域网 / 模拟器直连"]
        direction LR
        L1["App 服务器地址<br/>http://127.0.0.1:8000/weixin<br/>或 http://<宿主局域网IP>:8000/weixin"]
        L2["adb reverse tcp:8000 tcp:8000"]
        L3["Flask 0.0.0.0:8000"]
        L1 --> L2 --> L3
    end
    subgraph PUB["链路 B · 公网 HTTPS"]
        direction LR
        P1["App / iPhone PWA<br/>https://your-domain.example/mmonitor/weixin<br/>https://your-domain.example/mmonitor/console?token="]
        P2["VPS nginx :443<br/>/etc/nginx/sites-enabled/your-domain.example<br/>location /mmonitor/ 反代块"]
        P3["VPS 本地 127.0.0.1:23444<br/>frps · /etc/frps/frps.toml<br/>allowPorts 必须含 23444<br/>否则 port not allowed"]
        P4["宿主机 frpc 隧道<br/>frpc/frpc.toml<br/>mmonitor 块 localPort 8000 → remotePort 23444<br/>热重载 curl -u admin:... 127.0.0.1:7400/api/reload"]
        P5["Flask 127.0.0.1:8000"]
        P1 --> P2 --> P3 --> P4 --> P5
    end
    DBG["排障顺序：Flask 存活<br/>（127.0.0.1:8000/messages 带 token → 200）<br/>→ frpc 隧道在跑 → nginx"]
    SEC2["安全红线：默认定位局域网/自控服务器<br/>Flask 内置服务器不用于高并发生产<br/>公网必须 WEIXIN_TOKEN（长随机）+ HTTPS<br/>可 caddy/nginx 反代或 frp，绝不裸奔<br/>令牌当密码，永不提交<br/>messages.jsonl / messages.db 含聊天原文"]
    PUB --> DBG
    DBG --> SEC2
end

