        B1["applicationIdSuffix .test<br/>versionNameSuffix -test<br/>resValue app_name = 微信分析助手·测试"]
        B2["DEFAULT_ANALYSIS_PROTOCOL = openai<br/>DEFAULT_ANALYSIS_URL = secret GLM_BASE_URL<br/>DEFAULT_ANALYSIS_KEY = secret GLM_API_KEY<br/>DEFAULT_ANALYSIS_MODEL = secret GLM_MODEL<br/>DEFAULT_LAYA_URL = secret JEV_URL<br/>DEFAULT_LAYA_KEY = secret JEV_API_KEY<br/>DEFAULT_SERVER_URL = secret MONITOR_URL<br/>DEFAULT_MONITOR_TOKEN = secret MONITOR_TOKEN"]
