        REDACT["RedactorPreviewActivity<br/>脱敏规则预览"]:::ui
    end

    subgraph L2["② 采集与常驻层 · 系统绑定组件"]
        direction LR
        NL["NotifyMeListener<br/>NotificationListenerService<br/>AppSourceStore 启用集合过滤 · 丢弃 ongoing/摘要<br/>EXTRA_MESSAGES 解析 · LRU 去重"]:::svc
        A11Y["A11yExtractService<br/>AccessibilityService（仅微信启用）<br/>标题识别 · 逐屏翻页 · 防碎裂降级"]:::svc
        KA["KeepAliveService<br/>前台服务 dataSync<br/>60s 看门狗 requestRebind"]:::svc
        BOOT["BootReceiver<br/>BOOT_COMPLETED"]:::svc
        ALARMR["ReminderReceiver<br/>到点高优先级通知"]:::svc
        OVS["OverlayService<br/>悬浮窗 · 会话级操作"]:::svc
        OVR["OverlayActionReceiver<br/>悬浮窗动作回调"]:::svc
    end

    subgraph L3["③ 后台任务层 · WorkManager（UniqueWork + UPDATE）"]
        direction LR
        SYNCW["SyncWorker<br/>三通道上报<br/>消息 / 分析 / 顾问"]:::work
        ANAW["AnalysisWorker<br/>逐会话窗口 case 分析<br/>单轮 ≤10 会话 · 间隔 500ms"]:::work
        ADVW["AdvisorWorker<br/>近 7 天复盘<br/>≤50 case · 摘要截 30 字"]:::work
        MDW["ModelDownloadWorker<br/>前台下载 · .part 续传<br/>每 512KB 写进度"]:::work
        SCHED["SyncScheduler · AnalysisScheduler · AdvisorScheduler<br/>周期 15/30/60/120 分钟 · NetworkType.CONNECTED"]:::work
    end

    subgraph L4["④ 领域 / 决策层 · 既有内核"]
        direction LR
        CASE["AnalysisCase<br/>会话窗口 case<br/>caseId = sha1(pkg|conversation|windowEnd)[:16]"]:::dom
        FORK["ForkPrefilter<br/>fork1 本地启发式预筛<br/>系统消息 / 纯表情 / 广告 / 窗口过小"]:::dom
        CAL["CalendarHelper<br/>三级降级提醒链"]:::dom
        ALARMH["AlarmHelper<br/>setAndAllowWhileIdle"]:::dom
        REPLY["MessageReplier<br/>RemoteInput 直接回复<br/>仅用户手动触发"]:::dom
        HIST["HistorySync<br/>启动回填 · 6 小时冷却"]:::dom
        ENGINE2["LocalLlmEngine · LayaTfliteEngine<br/>端侧推理抽象 · LiteRT 2.2.0"]:::dom
    end

    subgraph L4B["④-2 本轮新增 Core 逻辑内核 ×29（纯 JVM · 无 Android 依赖 · app/src/test 63 个 .kt / 910 条覆盖）"]
        direction LR
        C1["同步与上报<br/>SyncOutcome.kt 192（207 先于 2xx）<br/>SyncBatchCore.kt 84（200 条 / 1 MiB · 二分）<br/>SyncWatermarkCore.kt 57（已结算前缀）<br/>AnalysisSyncCore.kt 60 · AdvisorSyncCore.kt 44<br/>HistorySyncCore.kt 62（隐私门控 · MAX_PAGES=20）"]:::dom
        C2["拒绝与隔离<br/>AnalysisRejectCore.kt 238（被拒计数 + 隔离）<br/>AdvisorRejectCore.kt 213（复用 AnalysisRejectCore）<br/>PendingRejectCore.kt 66（被拒计数 + 丢弃上限）"]:::dom
        C3["扫描与调度<br/>AnalysisScanCursor.kt 265（字节游标 + 环形重扫）<br/>AnalysisScheduleSummaryCore.kt 71（Health 自愈阈值）"]:::dom
        C4["脱敏与标签<br/>RedactorCore.kt 293（ID_CARD/PHONE/NAME 规则）<br/>AliasSaltCore.kt 143（姓名别名设备随机盐 · 可重置）<br/>ConvTagCore.kt 47（NONE/TODO/TRACK/DONE/NOISE）"]:::dom
        C5["交互与提醒<br/>ManualReminderCore.kt 117（先解析成功再落库）<br/>ReminderChainCore.kt 106（三级降级决策：L1 日历 → L2 唤起 → L3 闹钟）<br/>TodoPanelCore.kt 27（DEFAULT_LIMIT=8 · 首页联动）"]:::dom
        C6["解析与评测口径<br/>NotificationTextCore.kt 124（剥未读前缀 · 切发言人 · 判群聊）<br/>QueueStateCore.kt 156（排队上报口径）<br/>S1EvalBudgetCore.kt 83（单次 90s · 整轮 15min 预算）"]:::dom
        C7["版本与元信息<br/>VersionInfoCore.kt 95（版本行带 versionCode · 渠道/构建文案 · 复制报障信息）"]:::dom
        C8["去重与清理<br/>MessageDedupeCore.kt 174（历史重复归并 · 保留最早一条 · 裸正文不动）"]:::dom
        C9["筛选与视图<br/>AppFilterCore.kt 88（首页来源筛选 · chip 只列窗口内来源 · 选中项消失回落全部）"]:::dom
        C10["分析范围<br/>AnalysisScopeCore.kt 286（周期区间 · 点名会话跳名单与去重 · 落盘只存选择）"]:::dom
        C11["顾问通道<br/>AdvisorDigestCore.kt 179（窗口反推发送者名单 · 两条顾问通道都走姓名别名 · ≤50 case / 摘要截 30 字）"]:::dom
        C12["搜索与本地化<br/>SearchCore.kt 137（四类命中：会话名/来源 App/消息/分析结论 · 搜索态强制展开 · 命中来源提示）"]:::dom
        C13["文案与本地化<br/>TopicLabelCore.kt 229（topic / due_window 码值↔中文档名双向归一 · 四处重复实现已删除 · 首页「截止：none」与待办码值泄漏已修）"]:::dom
        C14["提醒列表<br/>ReminderListCore.kt 175（分组：需要处理 → 生效中 → 已过期 · 组内按事件时间（过期倒序）· chip 筛选 · failed 与无时间不算过期）"]:::dom
    end

