    WX["微信 App<br/>com.tencent.mm"]:::ext
    FS["飞书 App<br/>com.ss.android.lark"]:::ext
    DT["钉钉 App<br/>com.alibaba.android.rimet"]:::ext

    subgraph DEV["📱 Android 设备 / 真机（HyperOS）"]
        direction TB
        NL["NotifyMeListener<br/>通知监听服务（零注入 · 按 AppSourceStore 启用集合过滤）"]:::app
        A11Y["A11yExtractService<br/>无障碍直读服务（免 root · 目前仅微信）"]:::app
        CORE["微信分析助手 App 主体<br/>多应用采集 · 分析 · 提醒 · 上报"]:::app
        STORE[("files/*.jsonl<br/>SharedPreferences<br/>files/models/")]:::store
        NL --> CORE
        A11Y --> CORE
        CORE <--> STORE
    end

    subgraph HOST["💻 PC 本机 · Windows"]
        direction TB
        FLASK["Flask 服务端<br/>server/app.py · 0.0.0.0:8000"]:::srv
        ADBEX["android_db_extract.py<br/>EnMicroMsg.db 解密直读"]:::srv
        PCEX["pc_db_extract.py<br/>PC 微信 4.x 库直读"]:::srv
        DB[("messages.db · messages.jsonl<br/>analyses 表 · advisor_reports.json<br/>android_db/ · pc_db/")]:::store
        FRPC["frpc 隧道<br/>localPort 8000 → remotePort 23444"]:::srv
        FLASK --> ADBEX
        FLASK --> PCEX
        FLASK <--> DB
        FRPC --> FLASK
    end

    subgraph VPS["☁️ VPS 公网入口"]
        direction TB
        NGINX["nginx :443<br/>location /mmonitor/"]:::srv
        FRPS["frps :23444<br/>allowPorts 白名单"]:::srv
        NGINX --> FRPS
    end

    subgraph AI["🧠 外部模型 / 下载服务"]
        direction TB
        LAYA["laya · JEV SystemOne<br/>POST /v1/systemone<br/>GET /v1/models"]:::llm
        GLM["OpenAI 兼容通道 · GLM<br/>POST /chat/completions"]:::llm
        MS["ModelScope CDN<br/>MiniCPM4-0.5B-MNN 311MB<br/>MiniCPM3-4B-GGUF 2.47GB"]:::llm
    end

    MUMU["MuMuManager.exe<br/>root shell + adb pull"]:::ext
    IPHONE["📱 iPhone Safari<br/>PWA 纯查看端"]:::ext

