<?xml version="1.0" encoding="utf-8"?>
<!-- M12 主页「最近待办」单行：待办文本 + 元信息（会话 · 截止）+ 编辑/日历/删除。
     点文本区进会话详情；按钮为小号文字链样式，与标题栏折叠按钮一致。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvHomeTodoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvHomeTodoMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/time_gray"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnHomeTodoEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="@string/todo_action_edit"
            android:textColor="@color/brand_green"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnHomeTodoCal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="@string/todo_action_calendar"
            android:textColor="@color/status_info"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnHomeTodoDel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="@string/todo_action_delete"
            android:textColor="@color/danger_red"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
