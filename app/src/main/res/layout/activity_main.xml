<?xml version="1.0" encoding="utf-8"?>
<!-- 首页：顶部标题栏 + 权限状态卡片 + 控制台入口 + 保活卡片 + 消息列表（卡片化）。
     外层 ScrollView 防超屏；按钮统一 46dp 高、等宽均分、三件套样式。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <!-- 标题栏：白底 + 居中标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- 分组折叠快捷操作：小号文字按钮，不占主操作区 -->
        <TextView
            android:id="@+id/btnCollapseAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/btn_collapse_all"
            android:textColor="@color/brand_green"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnExpandAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/btn_expand_all"
            android:textColor="@color/brand_green"
            android:textSize="13sp" />

        <!-- M11 标题栏菜单：控制台 / 刷新 / 清除记录（主界面纯对话化后集中到这里） -->
        <TextView
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/menu_desc"
            android:padding="8dp"
            android:text="@string/menu_icon"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 组头点击热区说明：点文字区进详情、点箭头折叠 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/page_bg"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:text="@string/home_header_hint"
        android:textColor="@color/time_gray"
        android:textSize="11sp" />

    <!-- 搜索框：实时过滤会话名/发送者/消息文本，命中自动展开并高亮 -->
    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:hint="@string/search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:singleLine="true"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/time_gray"
        android:textSize="14sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- M11 权限告警条：仅未授权时显示（点击去开启），授权后主界面纯对话 -->
            <LinearLayout
                android:id="@+id/barPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvPermissionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnOpenSettings"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_secondary"
                    android:minHeight="0dp"
                    android:text="@string/btn_open_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/empty_hint"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <!-- 消息列表：卡片化 item，统一滚动交给外层 ScrollView。
                 用 FullHeightRecyclerView 强制全高测量，规避 wrap_content 被压成
                 视口剩余高度后内外都滚不动的问题（见该类注释）。 -->
            <com.notifyme.android.FullHeightRecyclerView
                android:id="@+id/recyclerMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
