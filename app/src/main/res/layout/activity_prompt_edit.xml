<?xml version="1.0" encoding="utf-8"?>
<!-- 会话级自定义提示词编辑页：标题栏（返回+会话名）+ 说明 + 3 个内置模板按钮 + 多行编辑框 + 保存/清除 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="@string/nav_back"
            android:textColor="@color/brand_green"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvConversationName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prompt_edit_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 内置模板：横排等宽，点击直接填入编辑框（不做变量表单，占位符由用户手改） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                style="@style/AppButtonSecondary"
                android:id="@+id/btnTemplate1"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/prompt_template_1_label"
                android:textSize="12sp" />

            <Button
                style="@style/AppButtonSecondary"
                android:id="@+id/btnTemplate2"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/prompt_template_2_label"
                android:textSize="12sp" />

            <Button
                style="@style/AppButtonSecondary"
                android:id="@+id/btnTemplate3"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/prompt_template_3_label"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 编辑框用 layout_weight 撑满剩余高度：外层内容容器已带 weight（占满屏幕剩余高度），
             拆掉任一层权重都会让编辑框塌陷成 0 高，故保留嵌套权重并显式豁免 NestedWeights -->
        <EditText
            tools:ignore="NestedWeights"
            android:id="@+id/etPrompt"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="top"
            android:hint="@string/prompt_edit_default_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                style="@style/AppButtonPrimary"
                android:id="@+id/btnSavePrompt"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/prompt_edit_save"
                android:textSize="14sp" />

            <Button
                style="@style/AppButtonDanger"
                android:id="@+id/btnClearPrompt"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="0dp"
                android:text="@string/prompt_edit_clear"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
