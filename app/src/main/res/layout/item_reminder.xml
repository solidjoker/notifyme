<?xml version="1.0" encoding="utf-8"?>
<!-- 提醒列表 item：卡片 + 标题行（标题 + 状态徽标）+ 时间/备注 + 操作按钮。
     按钮按需出现：「再次唤起」仅 Level 2 记录，「重试」仅失败记录。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvReminderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvReminderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="@color/card_bg"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvReminderTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvReminderNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/time_gray"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRemindAgain"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/btn_secondary"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/reminder_action_reopen"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRemindRetry"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_secondary"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/reminder_action_retry"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRemindDelete"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_secondary"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/reminder_action_delete"
            android:textColor="@color/accent_orange"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
