<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 定时上报需要联网；ACCESS_NETWORK_STATE 供 WorkManager 判断网络可达约束 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台保活：前台服务本体 + dataSync 类型声明（Android 14 起按类型授权） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- M9 悬浮通知：悬浮窗 + specialUse 类型 FGS（Android 14） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 前台服务通知在 Android 13+ 需要运行时权限，主界面会引导授予 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 开机自启拉起保活服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 引导用户把本 App 加入电池优化白名单，降低被懒回收概率 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 日历提醒：任务消息自动创建日历事件（运行时仍需用户授权） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Android 11+ 包可见性：
         - 无障碍直读「开始提取」需要拉起微信（跳回当前会话）；
         - 监听器取应用显示名也要能看见飞书/钉钉；
         未列出的 App 拿不到 label 时回落包名；不申请 QUERY_ALL_PACKAGES（Play 受限且无必要）。 -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.ss.android.lark" />
        <package android:name="com.alibaba.android.rimet" />
    </queries>

    <!-- 网络安全：默认仅 HTTPS（见 res/xml/network_security_config.xml）；
         明文 HTTP 只对本机回环/模拟器宿主放行，debug 构建整体放行便于局域网联调 -->
    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 控制台与各功能页：仅本 App 内部跳转 -->
        <activity android:name=".ConsoleActivity" android:exported="false" />
        <activity android:name=".CaptureActivity" android:exported="false" />
        <activity android:name=".AnalysisSettingsActivity" android:exported="false" />
        <activity android:name=".ReminderSettingsActivity" android:exported="false" />
        <activity android:name=".PrivacySettingsActivity" android:exported="false" />
        <activity android:name=".OverlaySettingsActivity" android:exported="false" />
        <activity android:name=".OnboardingActivity" android:exported="false" />
        <activity android:name=".WatchlistActivity" android:exported="false" />
        <activity android:name=".SourcesActivity" android:exported="false" />
        <activity android:name=".RedactorPreviewActivity" android:exported="false" />
        <activity android:name=".CaptureDiagnosticsActivity" android:exported="false" />
        <activity android:name=".EngineSmokeActivity" android:exported="false" />
        <activity android:name=".ReminderListActivity" android:exported="false" />
        <activity android:name=".AnalysisListActivity" android:exported="false" />
        <activity android:name=".ConversationActivity" android:exported="false" />
        <activity android:name=".PromptEditActivity" android:exported="false" />
        <activity android:name=".ModelListActivity" android:exported="false" />

        <!-- WorkManager 长任务前台服务：模型大文件下载（dataSync，Android 14 起按类型授权） -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          通知监听服务：系统官方 API，零注入方案。M2 起多源（微信/飞书/钉钉……），
          不再写死单一包名，启用集合见 AppSourceStore。
          必须在声明上写死 android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"，
          保证只有系统能绑定；用户需在系统设置中手动授予通知访问权限。
        -->
        <service
            android:name=".NotifyMeListener"
            android:label="@string/listener_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 前台保活服务：仅供本 App 内部启动，exported=false；
             foregroundServiceType=dataSync 对应消息同步用途 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- M9 悬浮通知服务：specialUse，Android 14 要求声明用途属性 -->
        <service
            android:name=".OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="在其他应用之上显示重要消息悬浮卡与常驻悬浮球" />
        </service>

        <!--
          微信聊天无障碍直读服务（无需 root 的本机直读路线）。
          BIND_ACCESSIBILITY_SERVICE 保证只有系统能绑定；用户需在系统设置手动开启。
          只监听微信窗口（DEBUG 包运行时追加本 App 用于采集引擎自检）。
        -->
        <service
            android:name=".A11yExtractService"
            android:label="@string/a11y_service_label"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 开机自启。BOOT_COMPLETED 是系统保护广播，只有系统能发送，
             exported=false 也能收到（系统广播不受 exported 限制） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- App 内提醒（三级降级链 Level 3）的到点接收器：
             只收本 App AlarmManager 发来的显式 intent，exported=false 即可 -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.notifyme.android.action.REMINDER_ALERT" />
            </intent-filter>
        </receiver>

        <!-- M9 悬浮卡降级通知的动作接收 -->
        <receiver
            android:name=".OverlayActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.notifyme.android.action.DISMISS_CARD" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
